<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!--suppress MsbuildTargetFrameworkTagInspection -->
        <PackageId>DALib.Networking</PackageId>
        <PackageVersion>1.0.0</PackageVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>hybrasyl-512x512.png</PackageIcon>
        <ProjectUrl>https://github.com/eriscorp/Dalib.Networking</ProjectUrl>
        <Version>1.0.0</Version>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Authors>ERISCO, LLC</Authors>
        <Copyright>(C) 2026 ERISCO, LLC</Copyright>
        <RepositoryUrl>https://github.com/eriscorp/Dalib.Networking</RepositoryUrl>
        <Tags>hybrasyl; dalib; doomvas; packets; networking; protocol;</Tags>
        <Icon>hybrasyl-512x512.png</Icon>
        <Title>Dark Ages Networking Library</Title>
        <Description>A typed packet library for the DOOMVAS v1 network protocol: wire framing, per-connection cryptography, and the full client-to-server and server-to-client opcode surface.</Description>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath=""/>
    </ItemGroup>
    <ItemGroup>
        <None Include="hybrasyl-512x512.png" Pack="true" PackagePath=""/>
    </ItemGroup>
</Project>
